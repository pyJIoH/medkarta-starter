node_modules/
.DS_Store

# Входящие: только локально, в git попадает уже разобранное
inbox/*
!inbox/.gitkeep

# Сырые DICOM (МРТ/КТ) — слишком тяжёлые для git, хранятся локально
dicom/
*.dcm

# Геном: сырой файл ДНК-теста по умолчанию только локально — его нельзя «сменить», если он утечёт.
# Справочная база ClinVar большая и скачивается заново.
genome/raw/*
!genome/raw/.gitkeep
genome/ref/
